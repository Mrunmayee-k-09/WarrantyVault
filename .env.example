# Copy this file to .env and change SECRET_KEY before deployment.
SECRET_KEY=replace-this-with-a-long-random-secret

# Default: local SQLite database (no database server setup required).
# Optional MySQL example:
# DATABASE_URL=mysql+pymysql://warranty_user:your_password@localhost:3306/warrantyvault?charset=utf8mb4

# Optional custom document storage folder:
# UPLOAD_FOLDER=instance/uploads

# Set FLASK_DEBUG=1 only for local development.
# Set FLASK_DEBUG=1 only for local development.
FLASK_DEBUG=0

# Default to real SMTP submission. Use simulation only for local testing.
CLAIM_SUBMISSION_MODE=smtp
CLAIM_SIMULATION_ALLOWED=false


# OCR: install the Tesseract application separately. On Windows, uncomment
# and adjust this path if tesseract.exe is not already on PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Outbound email (Gmail example: use a Google App Password, not your login password).
# Gmail commonly uses smtp.gmail.com, port 587, STARTTLS.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
MAIL_TIMEOUT=20

# Reminder worker runs once daily at this local time.
TIMEZONE=Asia/Kolkata
REMINDER_HOUR=9
REMINDER_MINUTE=0
